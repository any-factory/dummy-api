{
  "name": "dummy-api",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal Node.js API for testing the automated software factory workflow.",
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test",
    "test:handlers": "node --test test/handlers/*.test.mjs",
    "test:http": "node --test test/http.test.mjs",
    "lint": "eslint .",
    "format": "npm run lint -- --fix && prettier --write .",
    "check": "prettier --check . && npm run lint && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10"
  }
}
